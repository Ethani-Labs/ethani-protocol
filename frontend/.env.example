# ETHANI Frontend Environment Configuration
# Copy this file to .env.local and fill in your values

# ========== BACKEND API ==========
# Backend API base URL (development: http://localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ========== BLOCKCHAIN & SMART CONTRACTS ==========
# Network configuration (Arbitrum Sepolia Testnet - Jan 23, 2026)
NEXT_PUBLIC_NETWORK=arbitrum-sepolia
NEXT_PUBLIC_CHAIN_ID=421614
NEXT_PUBLIC_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.arbiscan.io

# ========== CONTRACT ADDRESSES (Arbitrum Sepolia Testnet - Deployed & Verified) ==========
# EthaniPricing Contract
NEXT_PUBLIC_CONTRACT_PRICING=0xc92fd01c122821Eb2C911d16468B20b07E25abC0

# EthaniRegion Contract
NEXT_PUBLIC_CONTRACT_REGION=0x5836cdDE4D05B0aBDB97AE556a0b9E3971a16143

# EthaniIncentive Contract
NEXT_PUBLIC_CONTRACT_INCENTIVE=0xE6C246d7Ba92c4d35076C91B686d104ad3118172

# EthaniCore Contract
NEXT_PUBLIC_CONTRACT_CORE=0x05aF2330e286197e4A2304fd708Aa333AB3ACDE4

# PriceOracle Contract
NEXT_PUBLIC_CONTRACT_ORACLE=0x139a3036052761341212C7d06488C27fb000a167

# Owner/Deployer Address
NEXT_PUBLIC_OWNER_ADDRESS=0x02cE05049D7A1dAEb7987CA9Ed5104003E7B778e

# ========== FEATURE FLAGS ==========
# AI/ML disabled - ETHANI uses deterministic rules only
NEXT_PUBLIC_AI_ENABLED=false
NEXT_PUBLIC_RULE_BASED_ONLY=true

# Demo mode (set to 'false' for production)
NEXT_PUBLIC_DEMO_MODE=false

NEXT_PUBLIC_CONTRACT_ROLE_MANAGER=0x...

# ProductRegistry Contract
# Purpose: Manage product catalog and metadata
NEXT_PUBLIC_CONTRACT_PRODUCT_REGISTRY=0x...

# ========== FEATURES ==========
# Enable blockchain integration (true/false)
NEXT_PUBLIC_ENABLE_BLOCKCHAIN=true

# Enable analytics tracking (true/false)
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Enable push notifications (true/false)
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=false

# Maintenance mode (true/false) - shows maintenance page
NEXT_PUBLIC_MAINTENANCE_MODE=false

# ========== APPLICATION METADATA ==========
NEXT_PUBLIC_APP_NAME=ETHANI
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_DESCRIPTION=Sistem Stabilisasi Harga Pangan Terdesentralisasi

# ========== DEPLOYMENT ==========
# Set to 'production' for production builds
NODE_ENV=development

# ========== DEVELOPMENT ONLY ==========
# Enable debug logging in development
DEBUG=ethani:*

# Allow CORS requests from specific origins
NEXT_PUBLIC_CORS_ORIGIN=http://localhost:3000

# ========== INSTRUCTIONS ==========
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in contract addresses after deploying smart contracts
# 3. Update API_URL to your backend server
# 4. Test with: npm run dev
# 5. For production, use environment variables in your hosting platform
